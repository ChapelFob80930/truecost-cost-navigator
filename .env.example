# TrueCost environment file. Copy to ".env" in the project root (next to the backend/ folder).
# ".env" is git-ignored: never commit it, never paste real values in chat or the Devpost.
# Real environment variables on the server override this file.

# ---- AI (Gemini) ------------------------------------------------------------
# Without a key the app still works: code extraction falls back to keyword rules, and the
# assistant screens only work in demo mode (pre-recorded answers).
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite
# Backup model, tried only if the main model keeps returning temporary errors (503/429). Leave empty to turn off.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ---- Database ---------------------------------------------------------------
# Option A (default): the SQLite file in the project root. Leave DATABASE_URL unset.
# DB_PATH=../truecost.db

# Option B: Tiger Data (Tiger Cloud Postgres). Set BOTH lines below.
# The password is a separate line so special characters need no URL-escaping.
# Get the host/port from the service's "Connect" panel in the Tiger Console.
# DATABASE_URL=postgres://tsdbadmin@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# PGPASSWORD=your-tiger-service-password

# ---- Web --------------------------------------------------------------------
# Who may call the API from a browser. "*" is fine for a demo; for the real site list your frontend,
# comma-separated, e.g. https://truecost.example.com,https://your-project.lovable.app
CORS_ORIGINS=*

# ---- Frontend only (Streamlit app; Lovable uses API_BASE in src/lib/api.ts instead) ----
# TRUECOST_API=https://YOUR-BACKEND-URL
