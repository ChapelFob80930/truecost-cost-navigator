[Unit]
Description=TrueCost API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=truecost
Group=truecost
WorkingDirectory=/opt/truecost/backend
# The app reads /opt/truecost/.env itself (Gemini key, DATABASE_URL, PGPASSWORD, CORS_ORIGINS).
ExecStart=/opt/truecost/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8010 --workers 2
Restart=always
RestartSec=3
# Hardening: the service only needs to read its own folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
