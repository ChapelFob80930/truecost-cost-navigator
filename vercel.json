{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "index:app",
      "functions": {
        "index.py": { "maxDuration": 60 }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "backend" } }
  ]
}
